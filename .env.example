# ==============================================================================
# JobPulse: Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# HeadHunter API Configuration
# Register an application at https://dev.hh.ru/admin
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here
HH_REDIRECT_URI=http://localhost:8000/callback
HH_OAUTH_HOST=rabota.by  # Use 'rabota.by' for Belarus, 'hh.ru' for Russia

# User-Agent is REQUIRED by HeadHunter API guidelines.
# Format: AppName/Version (Description; ContactEmail)
HH_USER_AGENT=JobPulse/1.0 (academic-research-cis; jobpulse-dev@example.com)

# Storage & Database
SQLITE_DB_PATH=data/staging.db
RAW_DATA_DIR=data/raw

# PostgreSQL (Analytical DWH - used in subsequent phases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Project Settings
LOG_LEVEL=INFO
REQUEST_DELAY_SECONDS=0.35
