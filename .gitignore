# Secrets & Configuration (CRITICAL: NEVER COMMIT CREDENTIALS)
.env
*.env
!.env.example
*.pem
*.key

# Data & Storage (Raw data and local DBs are not tracked in git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3

# Logs & Cache
*.log
logs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
